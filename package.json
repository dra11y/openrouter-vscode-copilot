{
	"name": "openrouter-vscode",
	"displayName": "OpenRouter for VS Code",
	"description": "OpenRouter models provider for VS Code Chat",
	"version": "0.1.0",
	"publisher": "dra11y",
	"engines": {
		"vscode": "^1.93.0"
	},
	"repository": {
		"url": "https://github.com/dra11y/openrouter-vscode-copilot"
	},
	"license": "AGPL-3.0-only",
	"activationEvents": [
		"onLanguageModelChat:dra11y.openrouter"
	],
	"categories": [
		"AI",
		"Chat"
	],
	"type": "module",
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "openrouter.resetApiKey",
				"title": "OpenRouter: Reset API Key"
			}
		],
		"configuration": {
			"title": "OpenRouter",
			"properties": {
				"openrouter.systemPrompt": {
					"type": "string",
					"default": "",
					"description": "Override the default Copilot system prompt. If set, replaces the first system message sent to the model (e.g. to change assistant name or instructions). Leave empty to use the default."
				}
			}
		},
		"languageModelChatProviders": [
			{
				"vendor": "dra11y.openrouter",
				"id": "dra11y.openrouter",
				"displayName": "OpenRouter VS Code Extension"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "pnpm run package",
		"compile": "vite build",
		"watch": "vite build --watch",
		"package": "vite build --minify",
		"vsce-package": "pnpm dlx vsce package --no-dependencies",
		"vsce-publish": "pnpm dlx vsce publish --no-dependencies",
		"check-types": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2",
		"@types/node": "25",
		"@types/vscode": "^1",
		"@vscode/vsce": "^3",
		"esbuild": "^0.28.0",
		"typescript": "^6",
		"vite": "^8"
	},
	"dependencies": {
		"@openrouter/sdk": "^0.12"
	},
	"enabledApiProposals": [
		"languageModelThinkingPart"
	]
}
